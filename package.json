{
  "name": "react-timezone-select",
  "version": "4.1.0",
  "description": "Usable, dynamic React Timezone Select",
  "scripts": {
    "dev": "concurrently \"tsup --watch\" \"cd example && pnpm dev\"",
    "prepublishOnly": "pnpm run build",
    "postpublish": "pnpm run build:example && npm run deploy",
    "build": "tsup && tsc --emitDeclarationOnly",
    "build:example": "cd example && pnpm run build",
    "deploy": "gh-pages -d example/dist",
    "pretest": "pnpm run build",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ci": "pnpm run build && pnpm test",
    "tsc": "tsc",
    "lint": "biome lint",
    "lint:fix": "biome lint --fix",
    "format": "biome check",
    "format:fix": "biome check --write"
  },
  "author": "Nico Domino <yo@ndo.dev>",
  "homepage": "https://github.com/ndom91/react-timezone-select",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndom91/react-timezone-select.git"
  },
  "bugs": {
    "url": "https://github.com/ndom91/react-timezone-select/issues"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "timezone",
    "select",
    "react-select"
  ],
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hook": {
      "types": "./dist/hook.d.ts",
      "import": "./dist/hook.js"
    }
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-select": "^5.10.2"
  },
  "peerDependenciesMeta": {
    "react-select": {
      "optional": true
    }
  },
  "dependencies": {
    "spacetime": "^7.17.0",
    "timezone-soft": "^1.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
